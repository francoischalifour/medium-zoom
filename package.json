{
  "name": "medium-zoom",
  "version": "1.1.2",
  "description": "A JavaScript library for zooming images like Medium. Works with React and any web framework.",
  "keywords": [
    "click-to-zoom",
    "dependency-free",
    "framework-agnostic",
    "image",
    "image-lightbox",
    "image-viewer",
    "image-zoom",
    "javascript",
    "lightbox",
    "lightbox-alternative",
    "lightweight",
    "medium",
    "medium-zoom",
    "nextjs",
    "photo-zoom",
    "picture",
    "react",
    "svelte",
    "typescript",
    "vanilla",
    "vanilla-js",
    "vue",
    "zero-dependency",
    "zoom",
    "zoom-image",
    "zoomable"
  ],
  "license": "MIT",
  "author": {
    "name": "Francois Chalifour",
    "email": "francois.chalifour@gmail.com",
    "url": "https://francoischalifour.com"
  },
  "repository": "francoischalifour/medium-zoom",
  "workspaces": [
    "website",
    "examples/*"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/medium-zoom.js",
    "./dist/medium-zoom.min.js",
    "./dist/medium-zoom.esm.js",
    "**/*.css"
  ],
  "main": "dist/medium-zoom.min.js",
  "module": "dist/medium-zoom.esm.js",
  "types": "dist/medium-zoom.d.ts",
  "scripts": {
    "start": "bun run dev",
    "dev": "tsdown --watch",
    "dev:website": "vite --config vite.website.config.mts --host 127.0.0.1",
    "stories": "bun run build && vite --config vite.stories.config.mts --host 127.0.0.1 --port 9001",
    "examples": "bun run build:website && vite preview --config vite.website.config.mts --host 127.0.0.1 --port 4173",
    "clean": "bun scripts/clean.ts",
    "build": "bun run clean && tsdown",
    "build:website": "bun run build && bun run build:demo",
    "build:demo": "vite build --config vite.website.config.mts && bun run build:stories && bun run build:examples",
    "build:stories": "vite build --config vite.stories.config.mts",
    "build:examples": "bun scripts/build-examples.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings src scripts tests stories/catalogue *.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run typecheck:examples",
    "typecheck:examples": "bun run --filter \"@medium-zoom/*-example\" typecheck",
    "test": "bun run test:browser",
    "test:browser": "playwright test",
    "test:package": "bun scripts/check-package.ts",
    "test:size": "bun scripts/check-size.ts",
    "check": "bun run check:library && bun run build:demo && bun run test:examples && bun run test:browser",
    "check:library": "bun run format:check && bun run lint && bun run build && bun run typecheck && bun run test:size && bun run test:package",
    "prepublishOnly": "bun run check",
    "dev:example": "bun scripts/dev-example.ts",
    "test:examples": "bun scripts/check-examples.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/core": "8.0.9",
    "@babel/preset-env": "8.0.7",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "acorn": "8.19.0",
    "lightningcss": "1.33.0",
    "medium-zoom-baseline": "npm:medium-zoom@1.1.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "publint": "0.3.25",
    "terser": "5.51.2",
    "tsdown": "0.23.2",
    "typescript": "7.0.2",
    "typescript-legacy": "npm:typescript@5.9.3",
    "vite": "8.3.5"
  },
  "packageManager": "bun@1.4.4"
}
