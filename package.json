{
  "name": "medium-zoom",
  "version": "1.1.2",
  "description": "Lightweight image zoom for the web. Zero dependencies, any framework, React via shadcn.",
  "keywords": [
    "angular",
    "astro",
    "click-to-zoom",
    "dependency-free",
    "framework-agnostic",
    "image",
    "image-lightbox",
    "image-viewer",
    "image-zoom",
    "javascript",
    "lightbox",
    "lightbox-alternative",
    "lightweight",
    "medium",
    "medium-zoom",
    "nextjs",
    "photo-zoom",
    "picture",
    "react",
    "shadcn",
    "solid",
    "solidjs",
    "svelte",
    "typescript",
    "vanilla",
    "vanilla-js",
    "vitepress",
    "vue",
    "zero-dependency",
    "zoom",
    "zoom-image",
    "zoomable"
  ],
  "homepage": "https://medium-zoom.francoischalifour.com",
  "license": "MIT",
  "author": {
    "name": "Francois Chalifour",
    "email": "francois.chalifour@gmail.com",
    "url": "https://francoischalifour.com"
  },
  "repository": "francoischalifour/medium-zoom",
  "workspaces": [
    "examples/*",
    "tests/fixtures/next"
  ],
  "files": [
    "dist/medium-zoom.js",
    "dist/medium-zoom.min.js",
    "dist/medium-zoom.esm.js",
    "dist/medium-zoom.d.ts",
    "dist/pure/index.js",
    "dist/pure/index.d.ts",
    "dist/pure/medium-zoom.umd.js",
    "dist/pure/medium-zoom.min.umd.js",
    "dist/style.css",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/medium-zoom.js",
    "./dist/medium-zoom.min.js",
    "./dist/medium-zoom.esm.js",
    "**/*.css"
  ],
  "main": "dist/medium-zoom.min.js",
  "module": "dist/medium-zoom.esm.js",
  "types": "dist/medium-zoom.d.ts",
  "scripts": {
    "dev": "tsdown --config config/tsdown.config.mts --watch",
    "dev:website": "bun run build && bun scripts/build-registry.ts && vite website --host 127.0.0.1",
    "dev:example": "bun scripts/dev-example.ts",
    "dev:gallery": "bun run build && vite playground/gallery",
    "stories": "bun run build && vite stories --host 127.0.0.1 --port 9001",
    "examples": "bun run build:website && vite preview website --host 127.0.0.1 --port 4173",
    "build": "bun scripts/clean.ts && tsdown --config config/tsdown.config.mts",
    "build:website": "bun run build && bun scripts/build-website.ts",
    "preview:website": "bun run build:website && wrangler dev --config website/wrangler.jsonc",
    "deploy:website": "bun run build:website && wrangler deploy --config website/wrangler.jsonc",
    "format": "bun fmt --no-config --flavor=prettier",
    "lint": "oxlint --config oxlint.config.mts --deny-warnings",
    "typecheck": "bun check --no-script -p tsconfig.json && bun check --no-script -p scripts && bun check --no-script -p website/tsconfig.json && bun scripts/check-docs.ts && bun run --filter \"@medium-zoom/*-example\" typecheck && mkdir -p .cache && wrangler types .cache/worker-types.d.ts --config website/wrangler.jsonc && bun check --no-script -p website/tsconfig.worker.json",
    "test:browser": "playwright test --config config/playwright.config.mts",
    "test:stress": "MEDIUM_ZOOM_STRESS_SEEDS=${MEDIUM_ZOOM_STRESS_SEEDS:-12} MEDIUM_ZOOM_STRESS_STEPS=${MEDIUM_ZOOM_STRESS_STEPS:-80} bun run test:browser gallery-stress.spec.ts",
    "test:package": "bun scripts/check-package.ts",
    "test:examples": "bun scripts/check-examples.ts",
    "size": "bun scripts/size.ts",
    "bench": "bun scripts/bench.ts",
    "check": "bun scripts/check.ts",
    "check:release": "bun scripts/check-release.ts",
    "generate:og": "bun scripts/generate-og.ts",
    "update:downloads": "bun scripts/update-npm-downloads.ts",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@altertable/altertable-js": "1.5.0",
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "8.0.10",
    "@babel/preset-env": "8.0.7",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@mdx-js/rollup": "3.1.1",
    "@pierre/highlights": "0.3.0",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "acorn": "8.19.0",
    "lightningcss": "1.33.0",
    "medium-zoom-baseline": "npm:medium-zoom@1.1.1",
    "minisearch": "7.2.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "terser": "5.51.2",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "typescript-legacy": "npm:typescript@5.9.3",
    "unified": "11.0.5",
    "vite": "8.3.5",
    "wrangler": "4.156.0"
  },
  "overrides": {
    "@emnapi/runtime": "1.11.3"
  },
  "packageManager": "bun@1.4.5"
}
