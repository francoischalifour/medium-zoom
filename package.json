{
  "name": "medium-zoom",
  "version": "1.1.3",
  "description": "Lightweight Medium-style image zoom for the web. Zero dependencies, any framework, React component via shadcn.",
  "keywords": [
    "click-to-zoom",
    "dependency-free",
    "framework-agnostic",
    "image",
    "image-lightbox",
    "image-viewer",
    "image-zoom",
    "javascript",
    "lightbox",
    "lightbox-alternative",
    "lightweight",
    "medium",
    "medium-zoom",
    "nextjs",
    "photo-zoom",
    "picture",
    "react",
    "shadcn",
    "svelte",
    "typescript",
    "vanilla",
    "vanilla-js",
    "vue",
    "zero-dependency",
    "zoom",
    "zoom-image",
    "zoomable"
  ],
  "homepage": "https://medium-zoom.francoischalifour.com",
  "license": "MIT",
  "author": {
    "name": "Francois Chalifour",
    "email": "francois.chalifour@gmail.com",
    "url": "https://francoischalifour.com"
  },
  "repository": "francoischalifour/medium-zoom",
  "workspaces": [
    "website",
    "examples/*",
    "tests/fixtures/next"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/medium-zoom.js",
    "./dist/medium-zoom.min.js",
    "./dist/medium-zoom.esm.js",
    "**/*.css"
  ],
  "main": "dist/medium-zoom.min.js",
  "module": "dist/medium-zoom.esm.js",
  "types": "dist/medium-zoom.d.ts",
  "scripts": {
    "start": "bun run dev",
    "dev": "tsdown --config config/tsdown.config.mts --watch",
    "dev:website": "bun run build:registry && vite --config config/vite.website.config.mts --host 127.0.0.1",
    "stories": "bun run build && vite --config config/vite.stories.config.mts --host 127.0.0.1 --port 9001",
    "examples": "bun run build:website && vite preview --config config/vite.website.config.mts --host 127.0.0.1 --port 4173",
    "clean": "bun scripts/clean.ts",
    "build": "bun run clean && tsdown --config config/tsdown.config.mts",
    "build:website": "bun run build && bun run build:demo",
    "deploy:website": "bun run build:website && wrangler deploy --config config/wrangler.jsonc",
    "preview:website": "bun run build:website && wrangler dev --config config/wrangler.jsonc",
    "build:demo": "bun run build:registry && bun run --cwd website build && bun run build:stories && bun run build:examples",
    "build:stories": "vite build --config config/vite.stories.config.mts",
    "build:examples": "bun scripts/build-examples.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings src scripts tests stories/catalogue config website/src website/build *.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --cwd website typecheck && bun scripts/check-docs.ts && bun run typecheck:examples",
    "typecheck:examples": "bun run --filter \"@medium-zoom/*-example\" typecheck",
    "test": "bun run test:browser",
    "test:browser": "playwright test --config config/playwright.config.mts",
    "test:package": "bun scripts/check-package.ts",
    "test:size": "bun scripts/check-size.ts",
    "check": "bun run check:library && bun run build:demo && bun run test:examples && bun run test:browser && bun run test:rsc && bun run test:analytics",
    "check:library": "bun run format:check && bun run build && bun run lint && bun run typecheck && bun run test:size && bun run test:package",
    "prepublishOnly": "bun run check",
    "dev:example": "bun scripts/dev-example.ts",
    "test:examples": "bun scripts/check-examples.ts",
    "build:registry": "bun scripts/build-registry.ts",
    "test:analytics": "playwright test --config config/playwright.analytics.config.mts",
    "generate:og": "bun scripts/generate-og.ts",
    "update:downloads": "bun scripts/update-npm-downloads.ts",
    "test:seo": "bun run test:browser website-metadata.spec.ts --project=chromium",
    "test:a11y": "bun run test:browser accessibility.spec.ts --project=chromium",
    "test:rsc": "playwright test --config config/playwright.rsc.config.mts",
    "test:docs": "bun scripts/check-docs.ts && bun run test:browser website-docs.spec.ts website-hierarchy.spec.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "8.0.9",
    "@babel/preset-env": "8.0.7",
    "@mdx-js/rollup": "3.1.1",
    "@pierre/highlights": "0.2.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitejs/plugin-react": "6.1.2",
    "acorn": "8.19.0",
    "lightningcss": "1.33.0",
    "medium-zoom-baseline": "npm:medium-zoom@1.1.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "publint": "0.3.25",
    "terser": "5.51.2",
    "tsdown": "0.23.2",
    "typescript": "7.0.2",
    "typescript-legacy": "npm:typescript@5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "packageManager": "bun@1.4.4"
}
