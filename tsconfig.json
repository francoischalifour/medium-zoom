{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "medium-zoom/pure": ["./src/pure.ts"],
      "medium-zoom/core": ["./src/core.ts"],
      "medium-zoom": ["./src/medium-zoom.ts"],
      "medium-zoom/dist/pure": ["./src/medium-zoom.ts"],
      "medium-zoom/dist/pure/index.js": ["./src/medium-zoom.ts"],
      "#platform": ["./src/platform/modern.ts"],
      "medium-zoom/modern": ["./src/index.ts"],
      "medium-zoom/compat": ["./src/index.ts"],
      "medium-zoom/compat/pure": ["./src/pure.ts"],
      "medium-zoom/renderers": ["./src/renderers/index.ts"],
      "medium-zoom/session": ["./src/session.ts"],
      "medium-zoom/gallery": ["./src/gallery.ts"],
      "medium-zoom/loaders": ["./src/loaders.ts"],
      "medium-zoom/viewport": ["./src/viewport.ts"],
      "medium-zoom/content": ["./src/content.ts"],
      "medium-zoom/triggers": ["./src/triggers.ts"]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "*.mts",
    "src/**/*.ts",
    "config/**/*.mts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "stories/catalogue/**/*.ts",
    "examples/*/vite.config.ts",
    "examples/shadcn/tests/experimental/**/*.tsx"
  ],
  "exclude": ["**/node_modules", "tests/fixtures/next/.next"]
}
