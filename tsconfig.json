{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun", "node", "vite/client"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "medium-zoom/pure": ["./src/preset/pure.ts"],
      "medium-zoom/core": ["./src/zoom/index.ts"],
      "medium-zoom": ["./src/preset/medium-zoom.ts"],
      "medium-zoom/dist/pure": ["./src/preset/medium-zoom.ts"],
      "medium-zoom/dist/pure/index.js": ["./src/preset/medium-zoom.ts"],
      "#platform": ["./src/platform/modern.ts"],
      "medium-zoom/modern": ["./src/preset/index.ts"],
      "medium-zoom/compat": ["./src/preset/index.ts"],
      "medium-zoom/compat/pure": ["./src/preset/pure.ts"],
      "medium-zoom/renderers": ["./src/zoom/dialog.ts"],
      "medium-zoom/transitions": ["./src/gallery/transition.ts"],
      "medium-zoom/gallery": ["./src/gallery/index.ts"],
      "medium-zoom/loaders": ["./src/zoom/hd-image.ts"],
      "medium-zoom/viewport": ["./src/zoom/viewport.ts"],
      "medium-zoom/content": ["./src/zoom/content.ts"],
      "medium-zoom/triggers": ["./src/zoom/triggers.ts"]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "*.mts",
    "src/**/*.ts",
    "config/**/*.mts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "tests/unit/geometry.test.mts",
    "stories/catalogue/**/*.ts",
    "playground/**/*.ts",
    "examples/*/vite.config.ts",
    "examples/shadcn/tests/experimental/**/*.tsx"
  ],
  "exclude": ["**/node_modules", "tests/fixtures/next/.next"]
}
