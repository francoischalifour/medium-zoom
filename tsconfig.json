{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "medium-zoom/pure": [
        "./src/pure.ts"
      ],
      "medium-zoom/core": [
        "./src/core.ts"
      ],
      "medium-zoom/features": [
        "./src/features/index.ts"
      ],
      "medium-zoom": [
        "./src/medium-zoom.ts"
      ],
      "medium-zoom/dist/pure": [
        "./src/medium-zoom.ts"
      ],
      "medium-zoom/dist/pure/index.js": [
        "./src/medium-zoom.ts"
      ],
      "#platform": [
        "./src/platform/modern.ts"
      ],
      "medium-zoom/modern": [
        "./src/index.ts"
      ],
      "medium-zoom/compat": [
        "./src/index.ts"
      ],
      "medium-zoom/compat/pure": [
        "./src/pure.ts"
      ],
      "medium-zoom/renderers": [
        "./src/renderers/index.ts"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "*.mts",
    "src/**/*.ts",
    "config/**/*.mts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "stories/catalogue/**/*.ts",
    "examples/*/vite.config.ts"
  ],
  "exclude": [
    "**/node_modules",
    "tests/fixtures/next/.next"
  ]
}
