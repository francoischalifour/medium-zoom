{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "types": ["vite/client", "node"],
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "paths": {
      "@/components/ui/image-zoom": [
        "../examples/shadcn/src/components/ui/image-zoom.tsx"
      ],
      "@/*": ["../src/*"],
      "medium-zoom": ["../src/preset/medium-zoom.ts"],
      "medium-zoom/dist/pure": ["../src/preset/medium-zoom.ts"],
      "medium-zoom/dist/pure/index.js": ["../src/preset/medium-zoom.ts"],
      "medium-zoom/core": ["../src/zoom/index.ts"],
      "#platform": ["../src/platform/compat.ts"]
    },
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "build/**/*"]
}
